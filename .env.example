# Tether Broker Configuration
# Path to the Write-Ahead Log file (defaults to tether.wal if unset)
TETHER_WAL_PATH="tether.wal"

# Worker poll cadence (e.g. 500ms for fast drain/demo, 30s for default)
TETHER_WORKER_POLL_INTERVAL="500ms"

# Simulated work duration per job (e.g. 400ms to keep gauges visible in demos, 0 for instant)
TETHER_DEMO_WORK_DURATION="400ms"